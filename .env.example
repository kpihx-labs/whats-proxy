# whats-proxy — optional environment overrides.
# Copy to $HOME/.config/whats-proxy/.env; all keys below are optional.
# Defaults live in src/whats_proxy/config.ts; no config.json exists.

# State directory containing auth, store, socket, PID, and this .env file.
# Example: WHATS_PROXY_STATE_DIR=$HOME/.config/whats-proxy
WHATS_PROXY_STATE_DIR=

# Daemon idle exit — exit after N minutes without RPC activity (0 = never).
# Example: WHATS_PROXY_MAX_IDLE_MINUTES=30
WHATS_PROXY_MAX_IDLE_MINUTES=0

# Reconnect delay in milliseconds after a transient disconnect.
# Example: WHATS_PROXY_RECONNECT_INTERVAL_MS=3000
WHATS_PROXY_RECONNECT_INTERVAL_MS=3000
# Maximum sequential reconnect attempts before the daemon reports disconnected.
# Example: WHATS_PROXY_MAX_RECONNECT=10
WHATS_PROXY_MAX_RECONNECT=10
# Whether to request complete history synchronization from WhatsApp.
# Example: WHATS_PROXY_SYNC_FULL_HISTORY=true
WHATS_PROXY_SYNC_FULL_HISTORY=true
# Whether Baileys refreshes its app-state data after authentication.
# Example: WHATS_PROXY_REFRESH_APP_STATE=true
WHATS_PROXY_REFRESH_APP_STATE=true
# Whether the WhatsApp account appears online while the daemon is connected.
# Example: WHATS_PROXY_MARK_ONLINE=false
WHATS_PROXY_MARK_ONLINE=false
# Whether pairing QR art is printed on stderr by admin setup.
# Example: WHATS_PROXY_PRINT_QR=true
WHATS_PROXY_PRINT_QR=true

# Persist the locally synchronized WhatsApp store between daemon restarts.
# Example: WHATS_PROXY_PERSIST_STORE=true
WHATS_PROXY_PERSIST_STORE=true
# Maximum messages retained per chat in the local store.
# Example: WHATS_PROXY_MAX_MESSAGES_PER_CHAT=5000
WHATS_PROXY_MAX_MESSAGES_PER_CHAT=5000
# Maximum chats retained in the local store.
# Example: WHATS_PROXY_MAX_CHATS=1000
WHATS_PROXY_MAX_CHATS=1000
