{
  "name": "whats-proxy",
  "version": "0.2.0",
  "description": "Non-MCP CLI proxy for WhatsApp — full whats-mcp catalog as flat JSON-RPC actions over a local daemon. Bun implementation mirroring tg-proxy.",
  "type": "module",
  "bin": {
    "whats-proxy": "./src/whats_proxy/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "CONTRACT.md",
    "AGENTS.md",
    ".env.example"
  ],
  "scripts": {
    "check": "bunx tsc --noEmit && bun test",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT"
}
